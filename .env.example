# ============================================================
# BorsaRobot — Ortam Değişkenleri Şablonu
# Kopyalayıp `.env` olarak kaydedin: `cp .env.example .env`
# ============================================================

# --- Veri Tabanı (SQLite — geliştirme; üretimde PostgreSQL) ---
DATABASE_URL="file:./dev.db"

# --- DenizBank API Market (Canlı mod — Faz 6) ---
# AppKey asla koda gömülmez (ADR-3 / Bölüm 2.1). Üretim anahtarı bankadan alınır.
# DENIZBANK_APP_KEY boş bırakılırsa VEYA DENIZBANK_MOCK=true ise sistem
# deterministik mock transport ile çalışır — gerçek banka çağrısı YAPILMAZ.
# Gerçek canlı bağlantı için: DENIZBANK_MOCK="false" + geçerli AppKey.
DENIZBANK_BASE_URL=""
DENIZBANK_APP_KEY=""
DENIZBANK_MOCK="true"

# --- Fiyat Kaynağı (Faz 7) ---
# YAHOO: gerçek BIST fiyatları (Yahoo Finance — API key gerektirmez).
# SIMULATED: yedek simülatör (random walk).
# Not: AdminSettings.priceSource önceliklidir; bu env yalnızca ayar
# okunamadığında/ilk kurulumda varsayılan olarak kullanılır.
PRICE_SOURCE="YAHOO"

# --- AI Sağlayıcı Anahtarları ---
# Not: API anahtarları admin panelinden AdminSettings tablosunda yönetilir.
# Buradaki değerler yalnızca `prisma/seed.ts` tarafından ilk kurulumda
# varsayılan olarak veri tabanına taşınır.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
GROK_API_KEY=""
MISTRAL_API_KEY=""
NVIDIA_API_KEY=""

# --- Local AI (Custom — Ollama / LM Studio / vLLM) ---
# OpenAI-uyumlu local sunucu yapılandırması. API key local AI'larda
# genellikle gerekmez (Ollama key istemez); boş bırakılabilir.
# Ollama:  http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1
CUSTOM_BASE_URL=""
CUSTOM_API_KEY=""
CUSTOM_MODEL=""

# --- Güvenlik (Faz A) ---
# Admin paneli (/admin) ve /api/admin/* uçları için şifre. Boş bırakılırsa
# kimlik doğrulama DEVRE DIŞI kalır (yalnızca geliştirme için önerilir).
# Üretimde MUTLAKA güçlü bir şifre tanımlayın.
ADMIN_PASSWORD=""

# AdminSettings'te saklanan API anahtarlarının AES-256-GCM şifreleme anahtarı.
# Boş bırakılırsa DATABASE_URL'den türetilir (geliştirme için yeterli).
# Üretimde en az 32 karakterlik rastgele bir değer kullanın:
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=""

# --- Uygulama ---
NEXT_PUBLIC_APP_NAME="BorsaRobot"
