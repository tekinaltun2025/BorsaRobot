{
  "name": "borsarobot",
  "version": "0.1.0",
  "private": true,
  "description": "AI Destekli Borsa Takip, Haber Analizi ve Otomatik Alım-Satım Platformu",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "verify:ai": "tsx scripts/verify-ai.ts",
    "verify:ai-decisions": "tsx scripts/verify-ai-decisions.ts",
    "verify:ai-providers": "tsx scripts/verify-ai-providers.ts",
    "verify:auto-trade": "tsx scripts/verify-auto-trade.ts",
    "verify:bist100": "tsx scripts/verify-bist100.ts",
    "verify:db": "tsx scripts/verify-db.ts",
    "verify:market": "tsx scripts/verify-market.ts",
    "verify:trading": "tsx scripts/verify-trading.ts",
    "verify:pnl": "tsx scripts/verify-pnl.ts",
    "verify:bulk-sell": "tsx scripts/verify-bulk-sell.ts",
    "verify:list-models": "tsx scripts/verify-list-models.ts",
    "verify:denizbank": "tsx scripts/verify-denizbank.ts",
    "verify:yahoo": "tsx scripts/verify-yahoo.ts",
    "verify:e2e": "tsx scripts/verify-e2e.ts",
    "verify:all": "tsx scripts/verify-db.ts && tsx scripts/verify-market.ts && tsx scripts/verify-trading.ts && tsx scripts/verify-pnl.ts && tsx scripts/verify-bulk-sell.ts && tsx scripts/verify-ai.ts && tsx scripts/verify-ai-decisions.ts && tsx scripts/verify-ai-providers.ts && tsx scripts/verify-bist100.ts && tsx scripts/verify-list-models.ts && tsx scripts/verify-auto-trade.ts && tsx scripts/verify-denizbank.ts && tsx scripts/verify-yahoo.ts && tsx scripts/verify-e2e.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.16.2",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.545.0",
    "next": "^15.5.6",
    "openai": "^7.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
